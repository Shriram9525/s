#include <stdio.h>
#include <stdlib.h>
#include <omp.h>

void merge(int a[], int l, int m, int r)
{
    int i=l, j=m+1, k=0;
    int *t=malloc((r-l+1)*sizeof(int));

    while(i<=m && j<=r)
        t[k++]=(a[i]<=a[j])?a[i++]:a[j++];

    while(i<=m) t[k++]=a[i++];
    while(j<=r) t[k++]=a[j++];

    for(i=l;i<=r;i++) a[i]=t[i-l];
    free(t);
}

void sort(int a[], int l, int r)
{
    if(l<r)
    {
        int m=(l+r)/2;
        sort(a,l,m);
        sort(a,m+1,r);
        merge(a,l,m,r);
    }
}

void psort(int a[], int l, int r, int d)
{
    if(l<r)
    {
        int m=(l+r)/2;

        if(d==0)
            sort(a,l,r);
        else
        {
            #pragma omp parallel sections
            {
                #pragma omp section
                psort(a,l,m,d-1);

                #pragma omp section
                psort(a,m+1,r,d-1);
            }
            merge(a,l,m,r);
        }
    }
}

int main()
{
    int n;

    printf("Enter number of elements (up to 1000000): ");
    scanf("%d",&n);

    if(n>1000000)
    {
        printf("Array size too large!\n");
        return 1;
    }

    int *a=malloc(n*sizeof(int));
    int *b=malloc(n*sizeof(int));

    for(int i=0;i<n;i++)
        a[i]=rand()%10000, b[i]=a[i];

    double s=omp_get_wtime();
    sort(a,0,n-1);
    double e=omp_get_wtime();

    double p=omp_get_wtime();
    psort(b,0,n-1,4);
    double q=omp_get_wtime();

    printf("\nTime taken by Sequential MergeSort: %.6f seconds\n",e-s);
    printf("Time taken by Parallel MergeSort : %.6f seconds\n",q-p);

    free(a);
    free(b);

    return 0;
}